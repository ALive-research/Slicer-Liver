     <property name="enabled">
      <bool>false</bool>
     </property>
     <property name="visible">
      <bool>false</bool>
     </property>
     <property name="toolTip">
      <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Materialise the seeded regions as a new Segmentation: one segment per seed, plus a Remnant for the unseeded rest.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
