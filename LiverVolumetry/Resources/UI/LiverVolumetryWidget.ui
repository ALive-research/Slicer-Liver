       </property>
       <property name="toolTip">
        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Check the resection(s) whose Bezier surfaces bound the pieces to measure.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
       </property>
       <property name="nodeTypes">
        <stringlist>
         <string>vtkMRMLResectionPlanNode</string>
