  </property>
  <property name="windowTitle">
   <string>Form</string>
  </property>
  <property name="layoutDirection">
   <enum>Qt::LeftToRight</enum>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="SegmentsSectionLabel">
     <property name="text">
      <string>Segments</string>
     </property>
     <property name="styleSheet">
      <string notr="true">font-weight: bold;</string>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QGridLayout" name="segmentsLayout">
     <item row="0" column="0">
      <widget class="qMRMLSegmentSelectorWidget" name="InputSegmentSelectorWidget">
       <property name="sizePolicy">
        <sizepolicy hsizetype="Preferred" vsizetype="Fixed">
         <horstretch>0</horstretch>
         <verstretch>0</verstretch>
        </sizepolicy>
       </property>
       <property name="toolTip">
        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Choose the segmentation and tick the segment(s) to measure. With no segment ticked, all segments are measured; the percentage column is measured against this same selection.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
       </property>
       <property name="segmentationNodeSelectorVisible">
        <bool>true</bool>
       </property>
       <property name="multiSelection">
        <bool>true</bool>
       </property>
       <property name="selectNodeUponCreation">
        <bool>false</bool>
       </property>
      </widget>
     </item>
     <item row="0" column="1" alignment="Qt::AlignTop">
      <widget class="qMRMLSegmentationShow3DButton" name="SegmentationShow3DButton"/>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QLabel" name="SeedsSectionLabel">
     <property name="text">
      <string>Seeds</string>
     </property>
     <property name="styleSheet">
      <string notr="true">font-weight: bold;</string>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QGridLayout" name="seedsActionLayout">
     <item row="0" column="0">
      <widget class="QPushButton" name="ClearAllSeedsButton">
       <property name="enabled">
        <bool>false</bool>
       </property>
       <property name="toolTip">
        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Remove every placed seed. Re-place seeds to start over.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
       </property>
       <property name="text">
        <string>Clear all</string>
       </property>
      </widget>
     </item>
     <item row="1" column="0" colspan="2">
      <widget class="QWidget" name="SeedsGroupWidget" native="true">
       <layout class="QGridLayout" name="seedsLayout">
        <property name="leftMargin">
         <number>0</number>
        </property>
        <property name="topMargin">
         <number>0</number>
        </property>
        <property name="rightMargin">
         <number>0</number>
        </property>
