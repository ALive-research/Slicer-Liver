      <widget class="QLabel" name="SeedsHintLabel">
       <property name="wordWrap">
        <bool>true</bool>
       </property>
       <property name="text">
        <string>Add a volume, then use its Place toggle to drop a seed in each region you want measured.</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QGridLayout" name="refineLayout">
     <item row="0" column="0" colspan="2">
      <widget class="QCheckBox" name="RefineByResectionCheckBox">
       <property name="toolTip">
        <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Optional. When on, each seed measures the piece bounded by the checked resection(s) instead of the whole region it sits in.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
